mas
neovim
nmap
redis
ssh-copy-id
terraform-1.17
tmux
ttf-nerd-fonts-symbols
tree-sitter-cli
wget

# Versioned or differently named in MacPorts, pick the right one with `port search`
# awscli (py3xx-awscli)
# kubectl (kubectl-1.xx)
# kubectx (kubectx and kubens; check `port search kubectx`, otherwise install from https://github.com/ahmetb/kubectx)
# postgresql (postgresql16 etc.)

# No port, install another way
# nodenv, node-build (git clone https://github.com/nodenv/nodenv and nodenv/node-build, or use the ports nvm / fnm / asdf instead)
# tpm (cloned by tmux/setup.sh)
