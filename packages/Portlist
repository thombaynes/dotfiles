# MacPorts equivalent of the Brewfile: one port per line, installed by setup.sh when MacPorts is present.
# Port names have not been verified. Check with `port search <name>`.
# MacPorts has no casks, so GUI apps (alfred, docker, ghostty, ...) need installing by hand.

# User testing
libsodium
rbenv
ruby-build

# General
coreutils
curl
duti
fd
fish
fzf
