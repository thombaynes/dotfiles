// Place your settings in this file to overwrite the default settings
{
    "workbench.iconTheme": "material-icon-theme",

    "editor.rulers": [79],
    "editor.roundedSelection": false,
    "editor.minimap.enabled": false,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.maxColumn": 100,
    "editor.renderWhitespace": "boundary",

    "files.trimTrailingWhitespace": true,

    "python.linting.pylintEnabled": true,
    "python.linting.pep8Enabled": false,

    "eslint.validate": [
      { "language": "javascript", "autoFix": true },
      { "language": "javascriptreact", "autoFix": true },
      { "language": "typescript", "autoFix": true },
      { "language": "typescriptreact", "autoFix": true }
    ],
    "javascript.preferences.quoteStyle": "single",

    "[typescript]": {
        "editor.tabSize": 2
    },

    "[javascript]": {
        "editor.tabSize": 2
    },

    "[html]": {
        "editor.tabSize": 2
    },
    "[ruby]": {
      "editor.defaultFormatter": "Shopify.ruby-lsp"
    },
    "rubyLsp.formatter": "standard",
    "rubyLsp.linters": [
      "standard"
    ],
    "rubyLsp.rubyVersionManager": {
      "identifier": "auto"
    },
    "rubyLsp.enabledFeatures": {

      "codeActions": true,
      "diagnostics": true,
      "documentHighlights": true,
      "documentLink": true,
      "documentSymbols": true,
      "foldingRanges": true,
      "formatting": true,
      "hover": true,
      "inlayHint": true,
      "onTypeFormatting": true,
      "selectionRanges": true,
      "semanticHighlighting": true,
      "completion": true
    },
    "rubyLsp.rubyExecutablePath": "/Users/tbaynes/.asdf/shims/ruby",
    "git.autofetch": true,
    "terminal.integrated.rendererType": "dom",
    "editor.tabSize": 2,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 500,
    "window.zoomLevel": 1,
    "editor.guides.indentation": true,
    "security.workspace.trust.untrustedFiles": "open",
    "go.toolsManagement.autoUpdate": true,
    "git.openRepositoryInParentFolders": "never",
    "vs-kubernetes": {
      "vscode-kubernetes.minikube-path-mac": "/Users/tbaynes/.vs-kubernetes/tools/minikube/darwin-arm64/minikube",
      "vscode-kubernetes.kubectl-path-mac": "/Users/tbaynes/.vs-kubernetes/tools/kubectl/kubectl",
      "vscode-kubernetes.helm-path-mac": "/Users/tbaynes/.vs-kubernetes/tools/helm/darwin-arm64/helm"
    },
    "editor.accessibilitySupport": "off",
    "github.copilot.editor.enableAutoCompletions": true,
    "fish.path.fish": "/opt/homebrew/bin/fish",
    "docker.extension.enableComposeLanguageServer": false,
    "[dockercompose]": {
      "editor.insertSpaces": true,
      "editor.tabSize": 2,
      "editor.autoIndent": "advanced",
      "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
      },
      "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
      "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "docker.extension.dockerEngineAvailabilityPrompt": false,
    "workbench.editor.autoLockGroups": {
      "mainThreadWebview-markdown.preview": true
    },
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "claudeCode.preferredLocation": "panel",
    "github.copilot.nextEditSuggestions.eagerness": "low",
    "chat.instructionsFilesLocations": {
      ".github/instructions": true,
      ".claude/rules": true,
      "~/.copilot/instructions": true,
      "~/.claude/rules": true,
      "/var/folders/30/mfw9wzdx64z_rzn8w9z5_rqr0000gp/T/postman-collections-post-response.instructions.md": true,
      "/var/folders/30/mfw9wzdx64z_rzn8w9z5_rqr0000gp/T/postman-collections-pre-request.instructions.md": true,
      "/var/folders/30/mfw9wzdx64z_rzn8w9z5_rqr0000gp/T/postman-folder-post-response.instructions.md": true,
      "/var/folders/30/mfw9wzdx64z_rzn8w9z5_rqr0000gp/T/postman-folder-pre-request.instructions.md": true,
      "/var/folders/30/mfw9wzdx64z_rzn8w9z5_rqr0000gp/T/postman-http-request-post-response.instructions.md": true,
      "/var/folders/30/mfw9wzdx64z_rzn8w9z5_rqr0000gp/T/postman-http-request-pre-request.instructions.md": true
    },
    "workbench.colorTheme": "Dark Modern",
    "git.blame.editorDecoration.enabled": true,
    "yaml.disableSchemaDetection": [],
    "makefile.configureOnOpen": false,
    "chat.disableAIFeatures": true
}
