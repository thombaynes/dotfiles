# Shared
tap "go-task/tap"           # The go-task cask lives here, not in homebrew/cask

# Auros
brew "libsodium"            # For orders repo
brew "rbenv"                # How ruby versions are managed at the time of onboarding
brew "ruby-build"           # Helps with rbenv somehow
brew "nodenv"               # How node versions are managed at the time of onboarding
brew "node-build"           # Helps with nodenv somehow
brew "nx"                   # Nx build system, used in the orders and results repos
cask "ngrok"                # Local dev can be shared

# General
brew "awscli"               # For AWS apps
brew "coreutils"            # Used to bring in a bunch of Linux utilities and make things more Linux like
brew "curl"                 # Great for one off API calls
brew "duti"                 # Allows file type defaulting to be scripted
brew "fd"                   # Without this fzf-lua has a checkHealth complaint in nvim. It actually uses ripgrep
brew "starship"             # Cross-shell prompt, used by zsh
brew "fzf"                  # Fuzzy File Finder for easy navigation. Needed by fzf-lua in nvim (<leader>p); depends on ripgrep
brew "git"                  # Source control
brew "helm"                 # Kubernetes package manager. Outside the local cluster section on purpose: useful without a local cluster
brew "jq"                   # JSON processor
brew "yq"                   # YAML processor
brew "ncurses"              # Has the tmux-256color terminfo entry older macOS lacks; tmux/setup.sh compiles it into ~/.terminfo
brew "ripgrep"              # MacOS grep is slooooow. This installs rg in the path. Used by fzf (see FZF_DEFAULT_COMMAND in zsh/.zprofile)
brew "mas"                  # For installing App store apps (see bottom of this file)
brew "hashicorp/tap/terraform" # Infrastructure as code. One version, no version manager
brew "tree-sitter-cli"      # Compiles treesitter parsers for nvim (neotest needs the Ruby one)
brew "neovim"               # Editor. Config lives in nvim; `vi` is aliased to nvim in zsh/.zshrc
brew "nmap"                 # Network Utility
brew "postgresql"           # Great DB
brew "redis"                # Great caching and sub tool
brew "ssh-copy-id"          # Utility for SSH keys
brew "tmux"                 # Terminal window manager. Will have a growing config file in this repo
brew "wget"                 # Utility for retrieving files
brew "zsh"                  # The login shell, newer than the one macOS ships. zsh/setup.sh makes it the login shell
brew "zsh-autosuggestions"  # Fish-style grey suggestions from history as you type (zsh is the login shell, see ./zsh)
brew "zsh-history-substring-search" # Fish-style Up/Down history search for what's typed so far
brew "zsh-syntax-highlighting" # Fish-style colouring of commands as you type


# Local Kubernetes cluster (~/home_repo/local-k8s). The profile's LOCAL_CLUSTER (see profiles/) switches these on or off.
# brew drops variables without the HOMEBREW_ prefix, so setup.sh passes it as HOMEBREW_LOCAL_CLUSTER. Without it, e.g. a hand-run brew bundle, they install
unless ENV["HOMEBREW_LOCAL_CLUSTER"] == "false"
  brew "kubernetes-cli"     # Kubernetes CLI which includes kubectl
  brew "kubectx"            # Installs kubectx and kubens for switching kubectl contexts and namespaces (uses fzf for the picker)
  brew "argocd"             # Argo CD CLI, used by local-k8s
  brew "k3d"                # Runs k3s clusters in containers (on Podman)
end

cask "alfred"                       # Used instead of Spotlight (and also offers a clipboard history)
cask "firefox"                      # Gotta have the fox
# The profile's TERMINAL (see profiles/) picks one of ghostty and iterm2. brew drops variables without the HOMEBREW_ prefix,
# so setup.sh passes it as HOMEBREW_TERMINAL. Without it, e.g. a hand-run brew bundle, both install
cask "ghostty" unless ENV["HOMEBREW_TERMINAL"] == "iterm2" # Terminal of choice. Config lives in ./ghostty
# cask "google-chrome"                # Gotta have Chrome (Managed by Auros)
cask "go-task/tap/go-task"          # Great for dev work
cask "hammerspoon"                  # ./hammerspoon has config details (left control is hyper key)
cask "iterm2" unless ENV["HOMEBREW_TERMINAL"] == "ghostty" # Terminal for older Macs that Ghostty doesn't support
cask "podman-desktop"                # GUI for managing containers and images with Podman
# cask "slack"                        # Messaging app (managed by Auros)
cask "sourcetree"                   # Git GUI app
cask "spotify"                      # For listening to music
cask "visual-studio-code"           # Decent Editor
cask "vlc"                          # For viewing video content (QuickTime is no good)
