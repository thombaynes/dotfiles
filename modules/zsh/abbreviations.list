# Abbreviations, inspired by fish: `gs` then Space or Enter becomes `git status`, so history holds the full command.
# One per line: the abbreviation, whitespace, then what it expands to. A trailing ` # comment` is ignored.
# `@name` as the expansion calls the zsh function `name` (defined in abbreviations.zsh) and uses its output.
# Read by abbreviations.zsh on every shell start, and by shortcuts/generate.sh for the cheat sheet.

b       bundle  # This is the same as bundle install
bs      brew services
bd      brew doctor
be      bundle exec
bi      bundle install
dcu     docker-compose up -d
dcd     docker-compose down
ga      git add
gaa     git add --all
gb      git branch
gbl     git branch --list
gbd     git branch -d
gc      git commit -m
gca     git commit --amend
gcan    git commit --amend --no-edit
gco     git checkout
gcob    git checkout -b
gd      git diff
gf      git fetch
gfo     git fetch origin
ghi     git hist
gl      git log
gm      git merge FETCH_HEAD --ff-only
gpl     git pull
gps     git push
gpsf    git push --force-with-lease
grb     git rebase
grba    git rebase --abort
grbc    git rebase --continue
grbi    git rebase -i origin/HEAD
grbm    @__abbr_grbm
grbom   git rebase origin/HEAD
grsh    git reset --hard origin/$(git branch --show-current)
grss    git reset --soft HEAD^
gs      git status
gsh     git stash
gshp    git stash pop
gsw     git switch
gswc    git switch -c
k       kubectl
ka      kubectl apply -f
kc      kubectl create -f
kds     kubectl describe
kdl     kubectl delete
ke      kubectl edit
kge     kubectl get all -o wide
kgn     kubectl get nodes -o wide
kgp     kubectl get pods -o wide
kgr     kubectl get replicasets -o wide
kpr     kyverno-policy-reporter
krs     kubectl rollout status
krh     kubectl rollout history
ll      ls -lhA
mci     mvn clean install
mcp     mvn clean pre-integration-test
n       nx
na      nx affected
nat     nx affected -t
nb      nx build
ne      nx e2e
nf      nx format:write
nfc     nx format:check
ngen    nx generate
ngr     nx graph
nln     nx lint
nmg     nx migrate
nr      nx run
nrm     nx run-many
nrmt    nx run-many -t
nrst    nx reset
ns      nx serve
nsp     nx show projects
nt      nx test
p       pnpm
pa      pnpm add
pad     pnpm add -D
pau     pnpm run audit:deps
pb      pnpm build
pci     pnpm install --frozen-lockfile
pdc     pnpm run depcheck
pdx     pnpm dlx
pe      pnpm exec
pf      pnpm format
pi      pnpm install
pl      pnpm lint
pls     pnpm ls
pout    pnpm outdated
prm     pnpm remove
prn     pnpm run
pst     pnpm start
pstd    pnpm start:dev
pstdb   pnpm start:debug
pstp    pnpm start:prod
pt      pnpm test
ptc     pnpm test:cov
ptd     pnpm test:debug
pte     pnpm test:e2e
ptu     pnpm test:unit
ptw     pnpm test:watch
pu      pnpm update
rc      bundle exec rails console
rdb     rails db:
rdbm    rails db:migrate
rdbp    rails db:prepare
rdbr    rails db:reset
rmod    rspec $(git ls-files --modified spec)
rps     rails parallel:spec
rs      rails server
rsp     bundle exec rspec
sr      bundle exec spring rails
srs     bundle exec spring rails s
src     bundle exec spring rails c
ta      terraform apply
ta0     terraform apply --refresh=false
tp      terraform plan
tp0     terraform plan --refresh=false
tr      terraform refresh
ts      terraform state
tsl     terraform state list
tsm     terraform state move
t       bin/utt
tpl     bin/utt pull
tps     bin/utt push
tpr     bin/utt prune
wtc     worktree-cleanup
